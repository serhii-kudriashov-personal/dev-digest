node_modules/
dist/
# agent-runner ships as a JS GitHub Action — its bundled dist/ MUST be committed
# (GitHub runs action.yml `main: dist/index.js` as-is, with no build step).
!agent-runner/dist/
!agent-runner/dist/**
build/
.next/
out/
coverage/
*.tsbuildinfo
.env
.env.local
.DS_Store
.idea/
.turbo/
.pnpm-store/
*.log
.devdigest/cache/
# pr-self-review verdict + gate logs — local state, and excluded from the tree
# hash the gate verifies (scripts/pr-self-review.sh)
.devdigest/pr-self-review.json
.devdigest/pr-self-review-logs/
# /impl run state — one file per run, so the loop survives a context compaction
# or a /clear. Same directory for the same reason: excluded from that tree hash.
.devdigest/impl/
clones/
playwright-report/
test-results/

# emdash worktree config (local)
.emdash.json
