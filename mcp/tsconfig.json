{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": false,
    "declaration": false,
    "sourceMap": true,
    "composite": false,
    "outDir": "dist",
    "types": ["node"],
    "lib": ["ES2022"],
    "rootDir": "src",
    "paths": {
      // Generated by `pnpm shared-dts` from the CANON at
      // `server/src/vendor/shared` — see tsconfig.shared-dts.json and
      // AGENTS.md §"Why the shared types come from a generated .d.ts".
      // Pointing this at the canon's .ts sources instead makes tsc pull them
      // into this program, which emits a second copy of every contract into
      // dist/ (importing `zod`, which is not a runtime dependency) and moves
      // the entry point to dist/mcp/src/index.js.
      "@devdigest/shared": ["./.shared-dts/index.d.ts"],
      "@devdigest/shared/*": ["./.shared-dts/*"],
      "zod": ["./node_modules/zod"],
      "zod/*": ["./node_modules/zod/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
